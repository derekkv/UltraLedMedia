# ---------- Infra (docker-compose) ----------
POSTGRES_USER=ultraled
POSTGRES_PASSWORD=ultraled
POSTGRES_DB=ultraled
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---------- API (apps/api) ----------
NODE_ENV=development
PORT=3000

# Conexiones
DATABASE_URL=postgresql://ultraled:ultraled@localhost:5432/ultraled?schema=public
REDIS_URL=redis://localhost:6379

# Sesión (cookie de servidor, stateful)
# Genera un secreto largo y aleatorio para producción (min 32 chars).
SESSION_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-32-o-mas
SESSION_COOKIE_NAME=ultraled_sid
SESSION_IDLE_TTL=1800        # segundos (30 min)
SESSION_ABSOLUTE_TTL=43200   # segundos (12 h)

# CORS (orígenes permitidos, separados por coma)
CORS_ORIGINS=http://localhost:5173

# Usuario admin inicial (seed)
ADMIN_EMAIL=admin@ultraled.media
ADMIN_PASSWORD=CambiarEsteAdmin123!

# ---------- Web (apps/web) ----------
VITE_API_URL=http://localhost:3000
