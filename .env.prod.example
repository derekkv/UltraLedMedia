# ============================================================
#  Variables de producción — copia esto como .env.prod
#  y NUNCA lo subas al repositorio.
# ============================================================

# --- Base de datos (Postgres local en Docker) ---
POSTGRES_USER=ultraled
POSTGRES_PASSWORD=CAMBIA_ESTO_POR_PASS_SEGURO
POSTGRES_DB=ultraled
# DATABASE_URL se construye automáticamente en docker-compose.prod.yml.
# Si usas Supabase en vez del Postgres local, ponlo aquí y ajusta el compose:
# DATABASE_URL=postgresql://postgres.XXX:PASS@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true

# --- Redis (container local) ---
REDIS_PASSWORD=CAMBIA_ESTO_POR_PASS_REDIS

# --- Sesión (mínimo 32 caracteres aleatorios) ---
# Genera con: openssl rand -base64 48
SESSION_SECRET=CAMBIA_ESTO_POR_AL_MENOS_32_CHARS_ALEATORIOS
SESSION_COOKIE_NAME=ultraled_sid
SESSION_IDLE_TTL=1800
SESSION_ABSOLUTE_TTL=43200

# --- CORS: tu dominio o IP pública ---
CORS_ORIGINS=https://app.tudominio.com

# --- Archivos adjuntos de clientes ---
# En producción, monta un volumen persistente en esta ruta (ver docker-compose).
UPLOADS_DIR=uploads
UPLOAD_MAX_BYTES=26214400

# --- Admin inicial (solo lo usa el seed, una vez) ---
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=CAMBIA_ESTA_PASSWORD_DE_ADMIN
