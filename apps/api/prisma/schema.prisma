// Ultraled Media - esquema de la base (Fase 1)
// Los 4 módulos de negocio (Venta, Cobranza, Gerencial, Clientes) se agregan después.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ModuleKey {
  VENTA
  COBRANZA
  GERENCIAL
  CLIENTES
}

enum PermissionAction {
  READ
  CREATE
  UPDATE
  DELETE
  MANAGE
}

enum GrupoComercial {
  GASTRONOMIA
  ROPA_MODA
  SALUD_BELLEZA
  TECNOLOGIA
  LICORES_DISCOTECA
  SUPERMERCADO_TIENDA
  SERVICIOS_PROFESIONALES
  FERRETERIA_CONSTRUCCION
  EDUCACION
  VEHICULOS_LIVIANOS
  VEHICULOS_PESADOS
  OTRO
}

enum MaterialPublicidad {
  ENTREGA_MATERIAL
  SOLICITA_DISENO
}

enum DuracionSpot {
  SEG_10
  SEG_15
  SEG_20
  SEG_30
}

enum PlanContratado {
  DIARIO
  SEMANAL
  MENSUAL
  TRIMESTRAL
  ANUAL
}

enum ModalidadPago {
  TRANSFERENCIA
  EFECTIVO
  DEUNA_PAYPHONE
}

enum FacturaCon {
  DATOS_RUC
  CONSUMIDOR_FINAL
}

enum ClienteEstado {
  ACTIVO
  PAUSADO
  VENCIDO
  CANCELADO
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  email               String    @unique
  passwordHash        String    @map("password_hash")
  fullName            String    @map("full_name")
  phone               String?
  isActive            Boolean   @default(true) @map("is_active")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(6)
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles         UserRole[]
  notifications Notification[]
  auditLogs     AuditLog[]

  @@index([email])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id     String           @id @default(uuid()) @db.Uuid
  module ModuleKey
  action PermissionAction
  key    String           @unique

  roles RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  title     String
  body      String
  data      Json      @default("{}")
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String
  entity    String?
  entityId  String?  @map("entity_id")
  ip        String?
  userAgent String?  @map("user_agent")
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Ficha de cliente del módulo Venta (Formulario Cliente Ultra Led).
/// Agrega en un solo registro la empresa, la publicidad, el plan/contrato y los pagos.
model Cliente {
  id String @id @default(uuid()) @db.Uuid

  // A. Información de la empresa cliente
  razonSocial        String         @map("razon_social")
  rucCedula          String         @unique @map("ruc_cedula") // normalizado (sin espacios/guiones, mayúsculas)
  representanteLegal String?        @map("representante_legal")
  actividadNegocio   String?        @map("actividad_negocio")
  grupoComercial     GrupoComercial @map("grupo_comercial")
  grupoComercialOtro String?        @map("grupo_comercial_otro")
  direccionLocal     String?        @map("direccion_local")
  facebook           String?
  instagram          String?
  tiktok             String?
  personaContacto    String?        @map("persona_contacto")
  telefonoWhatsapp   String?        @map("telefono_whatsapp")
  emailAccesoEnVivo  String?        @map("email_acceso_en_vivo")

  // B. Información de la publicidad
  queDeseaPublicitar String?            @map("que_desea_publicitar")
  tieneMaterial      MaterialPublicidad @map("tiene_material")
  costoDisenoExtra   Decimal?           @map("costo_diseno_extra") @db.Decimal(12, 2)
  textoPantalla      String?            @map("texto_pantalla")
  duracionSpot       DuracionSpot       @map("duracion_spot")

  // C. Plan y vigencia del contrato
  pantallasAsignadas    String?        @map("pantallas_asignadas")
  ubicacionPantallas    String?        @map("ubicacion_pantallas")
  fechaInicio           DateTime       @map("fecha_inicio") @db.Date
  fechaVencimiento      DateTime       @map("fecha_vencimiento") @db.Date
  planContratado        PlanContratado @map("plan_contratado")
  valorPlan             Decimal        @map("valor_plan") @db.Decimal(12, 2)
  reproduccionesDiarias Int            @map("reproducciones_diarias")

  // D. Información de pagos mensuales
  diaPagoMensual Int           @map("dia_pago_mensual")
  modalidadPago  ModalidadPago @map("modalidad_pago")
  facturaCon     FacturaCon    @map("factura_con")

  notas String?

  estado  ClienteEstado @default(ACTIVO)
  version Int           @default(0) // bloqueo optimista (concurrencia)

  createdById String? @map("created_by_id") @db.Uuid
  updatedById String? @map("updated_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  archivos ClienteArchivo[]

  @@index([estado])
  @@index([createdAt])
  @@index([razonSocial])
  @@map("clientes")
}

/// Archivo adjunto a la ficha de un cliente (imágenes, videos, PDF, documentos).
/// El binario vive en disco (UPLOADS_DIR/clientes/<clienteId>/<storedName>);
/// aquí solo se guardan los metadatos para listar, descargar y auditar.
model ClienteArchivo {
  id         String @id @default(uuid()) @db.Uuid
  clienteId  String @map("cliente_id") @db.Uuid
  nombre     String // nombre original del archivo (visible al usuario)
  storedName String @map("stored_name") // nombre único en disco
  mimeType   String @map("mime_type")
  tamano     Int // tamaño en bytes

  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
  @@map("cliente_archivos")
}
